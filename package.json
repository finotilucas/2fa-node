{
  "name": "2fa-node",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finotilucas/2fa-node.git"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "tsx bin/test.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "totp",
    "hotp",
    "otp",
    "authenticator",
    "one time password",
    "google authenticator",
    "authentication",
    "2FA",
    "2 factor",
    "node",
    "auth",
    "2fa",
    "mfa"
  ],
  "author": "Lucas Lima Finoti <lucas.finoti@protonmail.com>",
  "license": "MPL-2.0",
  "description": "Easy 2-Factor Integration For Node.js",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@japa/expect": "^3.0.3",
    "@japa/expect-type": "^2.0.3",
    "@japa/runner": "^4.1.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "type": "module",
  "dependencies": {
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  }
}
